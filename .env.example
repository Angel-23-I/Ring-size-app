# ============================================================
# DESARROLLO LOCAL (archivo .env, nunca en Git)
# ============================================================
# Clave de Gemini — SOLO servidor local (server/beta-proxy.mjs).
GEMINI_API_KEY=

# Modelo de visión (validado: gemini-3.5-flash-lite).
GEMINI_MODEL=gemini-3.5-flash-lite

# Solo aplican al proxy local (server/beta-proxy.mjs). En Vercel NO se usan.
PORT=3001
BETA_CORS_ORIGIN=http://localhost:5173

# Presupuesto global (ms) y por etapa (ms). Válidos en local y Vercel.
# Vercel Hobby permite hasta 300 s: el presupuesto de 55 s cabe con margen
# y vercel.json fija maxDuration 60 s para api/measure.js.
BETA_TOTAL_TIMEOUT_MS=55000
BETA_STAGE_TIMEOUT_MS=25000
BETA_MAX_MB=6

# Base del backend para el frontend (NO es secreto).
# Vacío = mismo origen (dev vía proxy Vite, prod vía /api de Vercel).
# VITE_BETA_API_URL=
# Para desactivar la Beta en el frontend: VITE_BETA_ENABLED=false

# ============================================================
# PRODUCCIÓN / VERCEL (dashboard → Settings → Environment Variables,
# marcar Development, Preview y Production según corresponda)
# ============================================================
# GEMINI_API_KEY=<clave real, solo servidor>
# GEMINI_MODEL=gemini-3.5-flash-lite
# BETA_CORS_ORIGIN=https://tu-app.vercel.app
# BETA_TOTAL_TIMEOUT_MS=55000
# BETA_STAGE_TIMEOUT_MS=25000
# BETA_MAX_MB=6
# (PORT no aplica en Vercel; VITE_BETA_API_URL no necesaria con mismo origen)
