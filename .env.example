# Copia a .env (nunca subir .env a Git) y completa SOLO en el servidor/entorno local.
# El frontend NUNCA debe leer GEMINI_API_KEY (no usar prefijo VITE_ para la clave).

# Clave de Gemini — SOLO servidor (server/beta-proxy.mjs). Sin esta clave la Beta responde 503.
GEMINI_API_KEY=

# Modelo de visión (validado con la API Key actual: gemini-3.5-flash-lite).
GEMINI_MODEL=gemini-3.5-flash-lite

# Puerto del proxy Beta y límites.
PORT=3001
BETA_MAX_MB=6
BETA_TIMEOUT_MS=45000

# Orígenes permitidos por CORS (lista separada por comas, sin '*').
# Desarrollo con Vite: http://localhost:5173
# Producción (p. ej. Vercel): configurar aquí el dominio real del frontend,
# por ejemplo BETA_CORS_ORIGIN=https://tu-app.vercel.app
BETA_CORS_ORIGIN=http://localhost:5173

# URL del proxy que usa el frontend (esto NO es secreto; la clave no viaja al cliente).
# VITE_BETA_API_URL=http://localhost:3001
# Para desactivar la Beta en el frontend: VITE_BETA_ENABLED=false
